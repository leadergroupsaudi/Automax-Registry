# Registry API. 8082 keeps this service off the core backend's 8080.
SERVER_PORT=8082
SERVER_HOST=0.0.0.0
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# One Registry database. Host port 5440 is the compose mapping.
DB_HOST=localhost
DB_PORT=5440
DB_USER=registry
DB_PASSWORD=registry
DB_NAME=registry
DB_SSLMODE=disable

# Host port 6382 is the compose mapping. Inside the api container this is redis:6379.
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=
REDIS_DB=0

# JetStream. Compose publishes host port 4224; an existing local NATS is often 4222.
NATS_URL=nats://localhost:4224

# Shared secret Caugar sends as Authorization: Bearer <token>.
# Replace this before the adapter is reachable outside your machine.
INGEST_TOKEN=local-dev-token
INGEST_EXTERNAL_SYSTEM=traccar-go

# Image names used by docker compose. On the server these are the Docker Hub images.
API_IMAGE=your-dockerhub-user/automax-registry:latest
ADAPTER_IMAGE=your-dockerhub-user/automax-adapter:latest
ADAPTER_PORT=8083
